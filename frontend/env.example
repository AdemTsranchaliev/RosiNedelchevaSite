# Празно = инструментът не се зарежда. Попълват се, когато имаш ключовете.

# Контейнер. През него минават таговете, които добавиш в Tag Manager.
NEXT_PUBLIC_GTM_ID=

# Директно от сайта, докато същите тагове още не са в контейнера.
# След като ги сложиш в GTM, задай true, за да не се броят двойно.
NEXT_PUBLIC_TAGS_IN_GTM=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_CLARITY_ID=

# Стойността на content от meta тага в Google Search Console.
NEXT_PUBLIC_GSC_VERIFICATION=
